[Unit]
Description=Pet Battle API
After=network.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/pet-battle-api
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/pet-battle-outline.env
ExecStart=/var/www/pet-battle-api/venv/bin/uvicorn pet_outline_api:app --host 127.0.0.1 --port 8061
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
